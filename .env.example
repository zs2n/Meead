# عنوان مشروع Supabase ومفتاحه العام (يظهران في المتصفح — آمنان مع RLS)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# مفتاح الخادم — سري جداً، لا يُرفع إلى Git ولا يُعرض في المتصفح
SUPABASE_SERVICE_ROLE_KEY=

# رابط الموقع (يُستخدم في روابط البريد وتسجيل الدخول)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------- اختياري: كل ما يلي يمكن تركه فارغاً ----------
# إشعارات البريد عبر Resend
RESEND_API_KEY=
NOTIFY_EMAIL=

# بيانات تواصل المنصة (تظهر في التذييل وصفحة "تواصل معنا" عند ضبطها)
NEXT_PUBLIC_CONTACT_EMAIL=
# رقم واتساب المنصة بصيغة دولية، مثال: 9665XXXXXXXX
NEXT_PUBLIC_WHATSAPP=

# حسابات التواصل الاجتماعي (روابط كاملة)
NEXT_PUBLIC_SOCIAL_X=
NEXT_PUBLIC_SOCIAL_INSTAGRAM=
NEXT_PUBLIC_SOCIAL_TIKTOK=
NEXT_PUBLIC_SOCIAL_SNAPCHAT=
NEXT_PUBLIC_SOCIAL_LINKEDIN=

# Google Analytics 4 (اختياري، مثال: G-XXXXXXXXXX). تحليلات Vercel تعمل دون إعداد.
NEXT_PUBLIC_GA_ID=
